---Jetson commands ---

Create venv:
cd AgricultureBot
python3 -m venv venv
source venv/bin/activate
pip3 install pyserial inputs fastapi uvicorn websockets opencv-python numpy pyrealsense2 matplotlib


---LIDAR---
git clone --recursive https://github.com/dexmate-ai/pyrplidarsdk.git
cd pyrplidarsdk
pip3 install .

Create agbot (should only have to do once):
sudo nano /etc/systemd/system/agbot.service

---------
[Unit]
Description=Agriculture Bot Server
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
User=<YOUR_USERNAME>
WorkingDirectory=/home/<YOUR_USERNAME>/AgricultureBot

ExecStart=/bin/bash /home/<YOUR_USERNAME>/AgricultureBot/startup.sh

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

-----------
sudo systemctl daemon-reload
sudo systemctl enable agbot
sudo systemctl start agbot
sudo systemctl status agbot
journalctl -u agbot -f


source ~/AgricultureBot/venv/bin/activate


uvicorn main:app --host 0.0.0.0 --port 8000


install node js:
curl -sL https://deb.nodesource.com/setup_20.x | sudo -E bash -
sudo apt-get install -y nodejs
npm install

#For the gps map
npm install leaflet react-leaflet
--- In Interface ---
npm run dev -- --webpack

---For automatic hotspot:
1. Turn on automatic log in.
2. Go to startup applications
3. Add -> Call it auto hotspot -> give it the following command assuming the hotspot name is robot: nmcli connection up robot

Check wifi settings:
nmcli device
nmcli show robot

Set correct wifi interface:
nmcli connection modify robot connection.interface-name wlP1p1s0

To connect to wifi via terminal:
look at wifi: nmcli device wifi list
sudo nmcli device wifi connect "YOUR_SSID" password "YOUR_PASSWORD"
ex.
sudo nmcli device wifi connect rokoko_suit1 password rokoko_suit2024!

http://10.42.0.124:3000/

---HOW TO CHECK FOR TTY PORTS---
1.
sudo dmesg --follow | grep -i tty
2. To read hardware info:
#replace ttyUSB0 with your device name
udevadm info --name=/dev/ttyUSB0 --attribute-walk | grep -E 'idVendor|idProduct'
3. To set a permanent id:
sudo nano /etc/udev/rules.d/99-usb-serial.rules
#replace 0403 and 6001 with your device's vendor and product id and my_device with your desired symlink name
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="my_device"
OR
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="12345", SYMLINK+="my_device_1"
ARDUINO = 'arduino'
ATTRS{idProduct}=="0042"
ATTRS{idVendor}=="2341"
ATTRS{idProduct}=="0002"
ATTRS{idVendor}=="1d6b"
ATTRS{dbc_idProduct}=="0010"
ATTRS{dbc_idVendor}=="1d6b"

ROVER RADIO = 'radio'
ATTRS{idProduct}=="6015"
ATTRS{idVendor}=="0403"
ATTRS{idProduct}=="0002"
ATTRS{idVendor}=="1d6b"
ATTRS{dbc_idProduct}=="0010"
ATTRS{dbc_idVendor}=="1d6b"

ROVER GPS = 'gps'
ATTRS{idProduct}=="01a9"
ATTRS{idVendor}=="1546"
ATTRS{idProduct}=="0002"
ATTRS{idVendor}=="1d6b"
ATTRS{dbc_idProduct}=="0010"
ATTRS{dbc_idVendor}=="1d6b"


99-usb-serial.rules:
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0042", SYMLINK+="arduino"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", SYMLINK+="radio"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", SYMLINK+="gps"

4. Reload
sudo udevadm control --reload-rules && sudo udevadm trigger
5. Test
ls -l /dev/my_device
